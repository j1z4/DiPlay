<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    Window backgrounds must be resource references: Android 9 and older read windowBackground with
    getResourceId(), so a literal colour there leaves the window with no background at all and
    dialogs draw over the screen behind them (#640, #617).
    OpenPlay's palette: true black, graphite dialogs; paper white by day.
    -->
    <color name="window_background_dark">#000000</color>
    <color name="window_background_light">#EEF1F5</color>
    <!-- Dialogs use the palette's surface (AppDialogsTest checks they match). -->
    <color name="dialog_background_dark">#14161B</color>
    <color name="dialog_background_light">#FFFFFF</color>
    <!-- The launcher icon's background, behind the mark. -->
    <color name="openplay_icon_background">#000000</color>
</resources>

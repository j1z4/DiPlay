<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- OpenPlay's palette (DiPlayPalette, design/ui-library/tokens.css): true black and one
         signal green. values-v26 repeats these styles with Outfit, OpenPlay's typeface. -->
    <style name="Theme.Xcertplay" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2FE46A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowBackground">@color/window_background_dark</item>
        <!-- Without it, API 31+ draws a white splash before the dark Home screen. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#000000</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Xcertplay.Light">
        <item name="android:colorAccent">#0B7A33</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">#EEF1F5</item>
        <item name="android:statusBarColor">#EEF1F5</item>
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#EEF1F5</item>
    </style>
    <style name="Theme.Xcertplay.Dialog.Dark" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2FE46A</item>
        <item name="android:windowBackground">@color/dialog_background_dark</item>
    </style>
    <style name="Theme.Xcertplay.Dialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0B7A33</item>
        <item name="android:windowBackground">@color/dialog_background_light</item>
    </style>
    <style name="Theme.AdbCluster" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>

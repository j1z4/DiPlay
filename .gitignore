# Android Studio and local IDE state
.idea/
*.iml
.vscode/

# Gradle and local tooling
.gradle/
.kotlin/
.android-sdk/
build/
local.properties

# Native build output
.cxx/
.externalNativeBuild/
captures/

# Local agent working notes
/agent_docs/

# OS files
.DS_Store
Thumbs.db
*.log
/.idea

# Local beta credentials and release signing (never commit)
.private/
*.jks
*.keystore
release-signing.properties

# Never commit credential containers or installable distribution artifacts.
*.pk8
*.p7b
*.p12
*.pfx
*.pem
*.key
*.apk
*.aab
# Except the runtime identity the app ships with, so source builds can authenticate.
!mobile/auth-assets/offline-mfi/identity.pk8
!mobile/auth-assets/offline-mfi/certificate.p7b
